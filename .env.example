# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
ZCODE_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_OAUTH_ORIGIN=https://chat.z.ai
ZAI_BUSINESS_BASE_URL=https://api.z.ai
# 线上公开 OAuth client id，不是 secret。
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=

# ── 云入口（ZCODE_SERVER_MODE=cloud 时生效；specs/cloud-agent/03 §2/§8）──
# 运行模式：local（默认）走本机入口；cloud 走云入口启动事务，缺认证/存储未就绪一律明确失败。
ZCODE_SERVER_MODE=local
# 云侧公网 origin（provider 回连与 attachment 地址的构造基点）；裸 origin，无 path/query。
ZCODE_CLOUD_PUBLIC_ORIGIN=
# 监听地址与端口（缺省 3030）。
#ZCODE_CLOUD_LISTEN_HOST=0.0.0.0
#ZCODE_CLOUD_LISTEN_PORT=3030
# 云持久卷；host 本体落 <dataDir>/.zcode/。
ZCODE_CLOUD_DATA_DIR=
# Web 产物目录；缺省按构建形态解析。
#ZCODE_CLOUD_WEB_DIR=
# 启用的沙箱 provider 清单（逗号分隔：e2b,modal,daytona）；不做默认兜底。
ZCODE_CLOUD_PROVIDERS=
# 部署显式勾选「未实测」provider（可选性放开；能力仍按声明拒绝，不伪造成功）。
#ZCODE_CLOUD_ALLOW_UNVERIFIED_PROVIDERS=
# 无账号登录态时的静态 fallback 模型（provider:model 形式）。
#ZCODE_CLOUD_MODEL=
# 并发 run 配额上限（预留在 provisioning/ready/paused/disconnected/draining 期间都占槽）。
#ZCODE_CLOUD_MAX_CONCURRENT_RUNS=2
# 可信单用户部署主体（UUID；与认证凭据绑定）。
ZCODE_CLOUD_PRINCIPAL_ID=
# 鉴权模式：token（默认，fail-closed）或 anonymous（本地调试逃生门）。
#ZCODE_CLOUD_AUTH_MODE=token
# 部署 token 以 0600 文件提供（环境变量不承载部署 token；anonymous 模式可缺）。
#ZCODE_SERVER_AUTH_TOKEN_FILE=
# 本地入口（mode=local）的明文 token（仅本地调试；云入口不读它）。
#ZCODE_SERVER_AUTH_TOKEN=
# 凭据加密 secret 的环境变量名（引用名，不是值本身）。
#ZCODE_CREDENTIAL_SECRET=ZCODE_CREDENTIAL_SECRET
# GitHub App（PR 发布/收口推送；不配置则 git grant 通路 fail-closed）。
#ZCODE_CLOUD_GITHUB_APP_ID=
#ZCODE_CLOUD_GITHUB_APP_PRIVATE_KEY_FILE=
#ZCODE_CLOUD_GITHUB_WEBHOOK_SECRET_FILE=
#ZCODE_CLOUD_GITHUB_ALLOWED_INSTALLATIONS=
# storage worker 入口覆盖；缺省按构建形态解析（一般无需设置）。
#ZCODE_CLOUD_STORAGE_WORKER_ENTRY=
# 沙箱模板/镜像引用（provider:ref，多家逗号分隔；禁止 latest，版本/digest 必须固定）。
#ZCODE_CLOUD_SANDBOX_TEMPLATE_REF=e2b:zcode-sandbox-template
# 按 provider 核实的可用期上限（provider:seconds，逗号分隔；未配置 = 未核实，不上报上限）。
#ZCODE_CLOUD_SANDBOX_MAX_LIFETIME_SECONDS=e2b:3600
# 空闲 pause 阈值（秒；缺省 600=10 分钟；0=显式禁用）。仅分级能力（pauseResume≠none，
# 实测解禁）provider 参与；idle drain 对 memory 级 provider 由空闲 pause 单轨替换。
#ZCODE_CLOUD_SANDBOX_IDLE_PAUSE_SECONDS=600
